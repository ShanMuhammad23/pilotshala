planation":null,"subject":"Navigation","book":"Pilotshala Practice Set","topic":"Basic Radio Theory"},{"image":"","difficulty":"medium","_id":"682e9d5dd715cc08c3f00bb2","question":"What is the metric distance of an NDB wavelength?","choices":[{"_id":"693e819d6a1995dddc7ad47e","isCorrect":false,"choice":"Decimetric"},{"_id":"693e819d6a1995dddc7ad47f","isCorrect":false,"choice":"Centimetric"},{"_id":"693e819d6a1995dddc7ad480","isCorrect":true,"choice":"Metric of Kilometric"}],"explanation":null,"subject":"Navigation","book":"Pilotshala Practice Set","topic":"Basic Radio Theory"},{"image":"","difficulty":"medium","_id":"682e9d5dd715cc08c3f00bbb","question":"The wavelength of VHF radio signal is?","choices":[{"_id":"693e819d6a1995dddc7ad481","isCorrect":false,"choice":"Millimetric"},{"_id":"693e819d6a1995dddc7ad482","isCorrect":false,"choice":"Centimetric"},{"_id":"693e819d6a1995dddc7ad483","isCorrect":true,"choice":"Metric"}],"explanation":null,"subject":"Navigation","book":"Pilotshala Practice Set","topic":"Basic Radio Theory"},{"image":"","difficulty":"medium","_id":"682e9d5dd715cc08c3f00bbd","question":"Atmospheric ducting close to the earth, is most likely?","choices":[{"_id":"693e819d6a1995dddc7ad484","isCorrect":false,"choice":"In an inversion with constant humidity at all altitudes"},{"_id":"693e819d6a1995dddc7ad485","isCorrect":true,"choice":"In an inversion with humidity decreasing with increasing altitude"},{"_id":"693e819d6a1995dddc7ad486","isCorrect":false,"choice":"Over land"}],"explanation":null,"subject":"Navigation","book":"Pilotshala Practice Set","topic":"Basic Radio Theory"},{"image":"","difficulty":"medium","_id":"682e9d5dd715cc08c3f00bb4","question":"VOR wavelenght is?","choices":[{"_id":"693e819d6a1995dddc7ad487","isCorrect":false,"choice":"2.46 Cm"},{"_id":"693e819d6a1995dddc7ad488","isCorrect":false,"choice":"24.6 Cm"},{"_id":"693e819d6a1995dddc7ad489","isCorrect":true,"choice":"2.46m"}],"explanation":null,"subject":"Navigation","book":"Pilotshala Practice Set","topic":"Basic Radio Theory"},{"image":"","difficulty":"medium","_id":"682e9d5dd715cc08c3f00bb1","question":"What is the first returning sky wave called?","choices":[{"_id":"693e819d6a1995dddc7ad48a","isCorrect":true,"choice":"The critical ray"},{"_id":"693e819d6a1995dddc7ad48b","isCorrect":false,"choice":"The sky ray"},{"_id":"693e819d6a1995dddc7ad48c","isCorrect":false,"choice":"The space wave"}],"explanation":null,"subject":"Navigation","book":"Pilotshala Practice Set","topic":"Basic Radio Theory"},{"image":"","difficulty":"medium","_id":"682e9d5dd715cc08c3f00bbc","question":"The wavelenght of I L S localizer is.","choices":[{"_id":"693e819d6a1995dddc7ad48d","isCorrect":false,"choice":"Milimetric"},{"_id":"693e819d6a1995dddc7ad48e","isCorrect":false,"choice":"Centimetric"},{"_id":"693e819d6a1995dddc7ad48f","isCorrect":true,"choice":"Metric"}],"explanation":null,"subject":"Navigation","book":"Pilotshala Practice Set","topic":"Basic Radio Theory"},{"image":"","difficulty":"medium","_id":"682e9d5dd715cc08c3f00bb3","question":"Which radio frequency employs the refraction properties of the ionosphere?","choices":[{"_id":"693e819d6a1995dddc7ad490","isCorrect":false,"choice":"EHF"},{"_id":"693e819d6a1995dddc7ad491","isCorrect":true,"choice":"HF"},{"_id":"693e819d6a1995dddc7ad492","isCorrect":false,"choice":"VHF"}],"explanation":null,"subject":"Navigation","book":"Pilotshala Practice Set","topic":"Basic Radio Theory"},{"image":"","difficulty":"medium","_id":"682e9d5dd715cc08c3f00bb5","question":"VOR wavelength is","choices":[{"_id":"693e819d6a1995dddc7ad493","isCorrect":false,"choice":"Millimetric"},{"_id":"693e819d6a1995dddc7ad494","isCorrect":false,"choice":"Centimetric"},{"_id":"693e819d6a1995dddc7ad495","isCorrect":true,"choice":"Metric"}],"explanation":null,"subject":"Navigation","book":"Pilotshala Practice Set","topic":"Basic Radio Theory"},{"image":"","difficulty":"medium","_id":"682e9d5dd715cc08c3f00bb0","question":"What is the minimum level that