h tied."}],"explanation":null,"subject":"Instruments","book":"Pilotshala Practice Set","topic":"Attitude Indicator"},{"image":"","difficulty":"medium","_id":"683fe726452555c3884c77e5","question":"The latitude nut _____________ an artificial horizon?","choices":[{"_id":"693e81ec6a1995dddc7afdd8","isCorrect":false,"choice":"Compensates for transport error."},{"_id":"693e81ec6a1995dddc7afdd9","isCorrect":true,"choice":"Is not fitted to."},{"_id":"693e81ec6a1995dddc7afdda","isCorrect":false,"choice":"Compensates for latitude error."},{"_id":"693e81ec6a1995dddc7afddb","isCorrect":false,"choice":"Compensates for earth rate errors."}],"explanation":null,"subject":"Instruments","book":"Pilotshala Practice Set","topic":"Attitude Indicator"},{"image":"","difficulty":"medium","_id":"683fe726452555c3884c77e6","question":"The gravity sensing unit in an artificial horizon is used to?","choices":[{"_id":"693e81ec6a1995dddc7afddc","isCorrect":true,"choice":"Prevent tilting of the gyro."},{"_id":"693e81ec6a1995dddc7afddd","isCorrect":false,"choice":"Prevent precession of the gyro."},{"_id":"693e81ec6a1995dddc7afdde","isCorrect":false,"choice":"Erect the gyro."},{"_id":"693e81ec6a1995dddc7afddf","isCorrect":false,"choice":"Provide signals to the autopilot."}],"explanation":null,"subject":"Instruments","book":"Pilotshala Practice Set","topic":"Attitude Indicator"},{"image":"","difficulty":"medium","_id":"683fe726452555c3884c77e7","question":"Classic artifical horizon indications turning through 180° at constant AOB?","choices":[{"_id":"693e81ec6a1995dddc7afde0","isCorrect":false,"choice":"Nose up and AOB too low."},{"_id":"693e81ec6a1995dddc7afde1","isCorrect":false,"choice":"Nose up and AOB too high."},{"_id":"693e81ec6a1995dddc7afde2","isCorrect":true,"choice":"Nose up and correct AOB."},{"_id":"693e81ec6a1995dddc7afde3","isCorrect":false,"choice":"Pitch attitude and AOB correct."}],"explanation":null,"subject":"Instruments","book":"Pilotshala Practice Set","topic":"Attitude Indicator"},{"image":"","difficulty":"medium","_id":"683fe726452555c3884c77e8","question":"An artificial horizon has ________ degrees of freedom in the __________ axis?","choices":[{"_id":"693e81ec6a1995dddc7afde4","isCorrect":false,"choice":"Two vertical."},{"_id":"693e81ec6a1995dddc7afde5","isCorrect":true,"choice":"Two horizontal."},{"_id":"693e81ec6a1995dddc7afde6","isCorrect":false,"choice":"One vertical."},{"_id":"693e81ec6a1995dddc7afde7","isCorrect":false,"choice":"One horizontal."}],"explanation":null,"subject":"Instruments","book":"Pilotshala Practice Set","topic":"Attitude Indicator"},{"image":"","difficulty":"medium","_id":"683fe726452555c3884c77e9","question":"Which or the following properties are possessed by a standby artificial horizon? 1. Independent power supply. 2. Integral gyro. 3. Remote (external) gyro. 4. Used only in emergencies. 5. At least one per pilot in JAR 25 aircraft.","choices":[{"_id":"693e81ec6a1995dddc7afde8","isCorrect":true,"choice":"1, 2."},{"_id":"693e81ec6a1995dddc7afde9","isCorrect":false,"choice":"2, 3."},{"_id":"693e81ec6a1995dddc7afdea","isCorrect":false,"choice":"3, 4."},{"_id":"693e81ec6a1995dddc7afdeb","isCorrect":false,"choice":"4, 5."}],"explanation":null,"subject":"Instruments","book":"Pilotshala Practice Set","topic":"Attitude Indicator"},{"image":"","difficulty":"medium","_id":"683fe726452555c3884c77ea","question":"If an aircraft turns through 270° at a constant rate of turn and AOB, the indications on its classic artificial horizon will be?","choices":[{"_id":"693e81ec6a1995dddc7afdec","isCorrect":false,"choice":"Bank left nose up."},{"_id":"693e81ec6a1995dddc7afded","isCorrect":true,"choice":"Bank right nose up."},{"_id":"693e81ec6a1995dddc7afdee","isCorrect":false,"choice":"Wings level nose up."},{"_id":"693e81ec6a1995dddc7afdef","isCorrect":false,"choice":"AOB and pitch attitude correct."}],"explanation":null,"subject":"Instruments","book":"Pilotshala Practice Set","topic":"Attitude Indicator"}]