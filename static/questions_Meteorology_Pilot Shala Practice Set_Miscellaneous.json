ation":"","_id":"682e9d56d715cc08c3f00296","question":"When is the diurnal temperature variation smallest?","choices":[{"_id":"693e81576a1995dddc7abc36","isCorrect":false,"choice":"When sky is clear"},{"_id":"693e81576a1995dddc7abc37","isCorrect":false,"choice":"During land breeze over the coastal areas"},{"_id":"693e81576a1995dddc7abc38","isCorrect":true,"choice":"When sky is overcast"},{"_id":"693e81576a1995dddc7abc39","isCorrect":false,"choice":"When winds are weak over the land surface"}],"subject":"Meteorology","book":"Pilot Shala Practice Set","topic":"Miscellaneous"},{"image":"","difficulty":"medium","explanation":"","_id":"682e9d56d715cc08c3f0029c","question":"How does friction affect surface wind?","choices":[{"_id":"693e81576a1995dddc7abc3a","isCorrect":false,"choice":"Strengthens and backs during landing"},{"_id":"693e81576a1995dddc7abc3b","isCorrect":true,"choice":"Decreases and backs during landing"},{"_id":"693e81576a1995dddc7abc3c","isCorrect":false,"choice":"Strengthens and backs during take off"},{"_id":"693e81576a1995dddc7abc3d","isCorrect":false,"choice":"Decreases and veers during landing"}],"subject":"Meteorology","book":"Pilot Shala Practice Set","topic":"Miscellaneous"},{"image":"","difficulty":"medium","explanation":"","_id":"682e9d56d715cc08c3f0028b","question":"In which areas is clear air turbulence (CAT) most likely?","choices":[{"_id":"693e81576a1995dddc7abc3e","isCorrect":false,"choice":"A high close to a dust storm"},{"_id":"693e81576a1995dddc7abc3f","isCorrect":false,"choice":"After the passage of a severe sandstorm"},{"_id":"693e81576a1995dddc7abc40","isCorrect":true,"choice":"A sharp trough aloft with winds of jet stream speed"},{"_id":"693e81576a1995dddc7abc41","isCorrect":false,"choice":"A ridge aloft"}],"subject":"Meteorology","book":"Pilot Shala Practice Set","topic":"Miscellaneous"},{"image":"","difficulty":"medium","explanation":"","_id":"682e9d56d715cc08c3f0029d","question":"What does the term “monsoon” mean?","choices":[{"_id