[{"image":"","difficulty":"medium","_id":"683fe728452555c3884c7ecc","question":"A modern Radio Altimeter uses the frequency band:","choices":[{"_id":"693a8ce7cba8ac949a6c5188","isCorrect":false,"choice":"VHF 30 - 300 Mhz"},{"_id":"693a8ce7cba8ac949a6c5189","isCorrect":true,"choice":"SHF 3000 Mhz - 30 Ghz"},{"_id":"693a8ce7cba8ac949a6c518a","isCorrect":false,"choice":"UHF 300 Mhz - 3 Ghz"},{"_id":"693a8ce7cba8ac949a6c518b","isCorrect":false,"choice":"HF 3 Mhz - 30 Mhz"}],"explanation":null,"subject":"Instruments","book":"Pilotshala Practice Set","topic":"Revision 3"},{"image":"","difficulty":"medium","_id":"683fe728452555c3884c7ecd","question":"An aircraft that is assessed as not being a threat would be indicated on a TCAS system as:","choices":[{"_id":"693a8ce7cba8ac949a6c518c","isCorrect":false,"choice":"a solid red square"},{"_id":"693a8ce7cba8ac949a6c518d","isCorrect":false,"choice":"a solid white or cyan diamond"},{"_id":"693a8ce7cba8ac949a6c518e","isCorrect":true,"choice":"a hollow white or cyan diamond"},{"_id":"693a8ce7cba8ac949a6c518f","isCorrect":false,"choice":"a solid yellow circle"}],"explanation":null,"subject":"Instruments","book":"Pilotshala Practice Set","topic":"Revision 3"},{"image":"","difficulty":"medium","_id":"683fe728452555c3884c7ece","question":"During descent through a block of airspace of constant temperature and while flying at a constant mach no will cause the CAS to:","choices":[{"_id":"693a8ce7cba8ac949a6c5190","isCorrect":true,"choice":"increase"},{"_id":"693a8ce8cba8ac949a6c5191","isCorrect":false,"choice":"decrease"},{"_id":"693a8ce8cba8ac949a6c5192","isCorrect":false,"choice":"remain constant"},{"_id":"693a8ce8cba8ac949a6c5193","isCorrect":false,"choice":"increase at a rate of 1·98°/1000 ft"}],"explanation":null,"subject":"Instruments","book":"Pilotshala Practice Set","topic":"Revision 3"},{"image":"","difficulty":"medium","_id":"683fe728452555c3884c7ecf","question":"The true altitude of an aircraft in flight is shown from:","choices":[{"_id":"693a8ce8cba8ac949a6c5194","isCorrect":false,"choice":"the standard atmosphere"},{"_id":"693a8ce8cba8ac949a6c5195","isCorrect":true,"choice":"pressure altitude"},{"_id":"693a8ce8cba8ac949a6c5196","isCorrect":false,"choice":"density altitude"},{"_id":"693a8ce8cba8ac949a6c5197","isCorrect":false,"choice":"temperature altitude"}],"explanation":null,"subject":"Instruments","book":"Pilotshala Practice Set","topic":"Revision 3"},{"difficulty":"medium","_id":"683fe728452555c3884c7ed0","question":"On a Turn and Slip indicator, needle to the left and ball to the right indicates:","choices":[{"isCorrect":false,"choice":"right turn not enough bank","_id":"685c1b63b106578edf72b7c4"},{"isCorrect":false,"choice":"left turn too much bank","_id":"685c1b63b106578edf72b7c5"},{"isCorrect":true,"choice":"left turn not enough bank","_id":"685c1b63b106578edf72b7c6"},{"isCorrect":false,"choice":"right turn too much bank","_id":"685c1b63b106578edf72b7c7"}],"explanation":"","subject":"Instruments","book":"Pilotshala Practice Set","topic":"Revision 3","image":null,"updatedAt":"2025-06-25T15:53:07.566Z"},{"image":"","difficulty":"medium","_id":"683fe728452555c3884c7ed1","question":"What is Density Altitude?","choices":[{"_id":"693a8ce8cba8ac949a6c519c","isCorrect":false,"choice":"temperature altitude"},{"_id":"693a8ce8cba8ac949a6c519d","isCorrect":false,"choice":"pressure altitude corrected for the prevailing temperature"},{"_id":"693a8ce8cba8ac949a6c519e","isCorrect":true,"choice":"the altitude in the International Standard Atmosphere at which the prevailing density would be found"},{"_id":"693a8ce8cba8ac949a6c519f","isCorrect":false,"choice":"pressure altitude corrected for Total Air Temperature"}],"explanation":null,"subject":"Instruments","book":"Pilotshala Practice Set","topic":"Revision 3"},{"image":"","difficulty":"medium","_id":"683fe728452555c3884c7ed2","question":"A Radio Altimeter is:","choices":[{"_id":"693a8ce8cba8ac949a6c51a0","isCorrect":false,"choice":"ground based 